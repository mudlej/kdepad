# KWin's screenshot interface: service, object and the errors that only say
# "not this window" or "not this time".
SHOTS = "org.kde.KWin.ScreenShot2"
SHOTS_OBJECT = "/org/kde/KWin/ScreenShot2"
SHOTS_PASSING_ERRORS = (f"{SHOTS}.Error.Cancelled", f"{SHOTS}.Error.InvalidWindow",
                        "org.freedesktop.DBus.Error.NoReply")


class ConfigError(Exception):
    pass


class BusError(Exception):
    pass


def load_config(path):
    raw = {}
    if path.exists():
        try:
            raw = tomllib.loads(path.read_text())
        except (OSError, tomllib.TOMLDecodeError) as error:
            raise ConfigError(f"{path}: {error}") from error

    unknown = set(raw) - {"shortcuts", "picker", "app"}
    if unknown:
        raise ConfigError(f"unknown section '{sorted(unknown)[0]}'; there is [shortcuts], [picker] and [[app]]")
    if (not isinstance(raw.get("shortcuts", {}), dict) or not isinstance(raw.get("picker", {}), dict)
            or not isinstance(raw.get("app", []), list)):
        raise ConfigError("shortcuts go in a [shortcuts] table, picker settings in a [picker] table "
                          "and each app in its own [[app]] table")

    shortcuts = dict(DEFAULT_SHORTCUTS)
    for key, value in raw.get("shortcuts", {}).items():
        if key not in shortcuts:
            raise ConfigError(f"[shortcuts] has no '{key}'; the keys are stash, picker and last")
        if not isinstance(value, str):
            raise ConfigError(f"[shortcuts] {key} must be text such as \"Meta+H\", or \"\" for none")
        shortcuts[key] = value

    picker = {"view": "list"}
    for key, value in raw.get("picker", {}).items():
        if key != "view":
            raise ConfigError(f"[picker] has no '{key}'; the only key is view")
        if value not in PICKER_VIEWS:
            raise ConfigError('[picker] view must be "list" or "grid"')
        picker[key] = value

    apps = []
    for number, entry in enumerate(raw.get("app", []), start=1):
        where = f"[[app]] number {number}"
        if not isinstance(entry, dict):
            raise ConfigError("apps are written as [[app]] tables")
        unknown = set(entry) - APP_KEYS
        if unknown:
            raise ConfigError(f"{where}: unknown key '{sorted(unknown)[0]}'")
        match = entry.get("match")
        match = [match] if isinstance(match, str) else match
        if not match or not all(isinstance(item, str) and item for item in match):
            raise ConfigError(f"{where}: 'match' must name the window class (see `kdepad windows`)")
        name = entry.get("name") or match[0]
        shortcut = entry.get("shortcut", "")
        command = entry.get("command", "")
        if not all(isinstance(item, str) for item in (name, shortcut, command)):
            raise ConfigError(f"{where}: name, shortcut and command must be text")
        slug = re.sub(r"[^a-z0-9]+", "_", name.lower()).strip("_") or f"app{number}"
        action = f"kdepad_app_{slug}"
        if any(app["action"] == action for app in apps):
            raise ConfigError(f"{where}: another app is already called '{name}'")
        apps.append({
            "name": name,
            "action": action,
            "match": [item.lower() for item in match],
            "shortcut": shortcut,
            "autostash": bool(entry.get("autostash", False)),
            "command": command,
        })
    return {"shortcuts": shortcuts, "picker": picker, "apps": apps}


def call(service, path, interface, method, *args, block=True, timeout=3000):
    message = QDBusMessage.createMethodCall(service, path, interface, method)
    message.setArguments(list(args))
    bus = QDBusConnection.sessionBus()
    if not block:
        bus.call(message, QDBus.CallMode.NoBlock)
        return None
    reply = bus.call(message, QDBus.CallMode.Block, timeout)
    if reply.type() == QDBusMessage.MessageType.ErrorMessage:
        raise BusError(f"{method}: {reply.errorMessage()}")
    values = reply.arguments()
    return values[0] if values else None


def kwin_scripting(method, *args):
    return call("org.kde.KWin", "/Scripting", "org.kde.kwin.Scripting", method, *args)


def desktop_file_icon(name):
    data_home = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local/share")
    data_dirs = (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
    for directory in [data_home, *data_dirs]:
        for candidate in (name, name.lower()):
            entry = Path(directory) / "applications" / f"{candidate}.desktop"
            try:
                for line in entry.read_text(errors="replace").splitlines():
                    if line.startswith("Icon="):
                        return line[5:].strip()
            except OSError:
                continue
    return ""


_icons = {}


def icon_for(window):
    key = (window["desktopFile"], window["cls"])
    if key not in _icons:
        icon = QIcon()
        for name in dict.fromkeys(filter(None, (window["desktopFile"], window["cls"], window["name"]))):
            for candidate in (desktop_file_icon(name), name, name.lower()):
                if not candidate:
                    continue
                icon = QIcon(candidate) if os.path.isabs(candidate) else QIcon.fromTheme(candidate)
                if not icon.isNull():
                    break
            if not icon.isNull():
                break
        _icons[key] = icon if not icon.isNull() else QIcon.fromTheme("application-x-executable")
    return _icons[key]


def title_of(window):
    return window["caption"] or window["app"] or window["cls"] or "Untitled window"


class Thumbnails(QObject):
    """Pictures of windows for the grid, taken one at a time by KWin's screenshot interface."""

    changed = pyqtSignal(str)  # the id of the window that has a new picture

    def __init__(self, parent=None):
        super().__init__(parent)
        self.images = {}       # window id -> QImage, already scaled down
        self.queue = deque()   # window ids waiting their turn
        self.current = None    # the window id being captured
        self.pipe = None       # read end of the pipe KWin writes the picture to
        self.notifier = None
        self.shape = None      # width, height, bytes per row and pixel format of that picture
        self.data = bytearray()
        self.stale = False     # the window being captured was shown again meanwhile
        self.failed = set()    # window ids KWin had no picture for
        self.refused = False   # KWin will not take pictures for us
        self.warned = False
        self.timeout = QTimer(self, singleShot=True, interval=5000)
        self.timeout.timeout.connect(self.finish)

    def request(self, window_ids, again=True):
        """Take these windows' pictures. Without `again`, only of those not tried yet."""
        if self.refused:
            return
        for window_id in window_ids:
            if not again and (window_id in self.images or window_id in self.failed):
                continue
            if (window_id != self.current or self.stale) and window_id not in self.queue:
                self.queue.append(window_id)
        self.capture_next()

    def keep(self, window_ids):
        """Forget every window that is not one of these."""
        window_ids = set(window_ids)
        self.images = {key: image for key, image in self.images.items() if key in window_ids}
        self.queue = deque(window_id for window_id in self.queue if window_id in window_ids)
        self.failed &= window_ids
        if self.current is not None and self.current not in window_ids:
            self.stale = True  # its picture, still on the way, is of the window as it was

    def capture_next(self):
        if self.current is not None or not self.queue:
            return
        self.current = self.queue.popleft()
        self.pipe, write_end = os.pipe()
        try:
            fcntl.fcntl(self.pipe, fcntl.F_SETPIPE_SZ, 1 << 20)  # a picture is tens of megabytes
        except OSError:
            pass
        bus = QDBusConnection.sessionBus()  # before the message: PyQt needs it to type the arguments
        message = QDBusMessage.createMethodCall(SHOTS, SHOTS_OBJECT, SHOTS, "CaptureWindow")
        message.setArguments([self.current, {"include-decoration": False, "include-shadow": False},
                              QDBusUnixFileDescriptor(write_end)])
        os.close(write_end)  # the message carries its own copy
        watcher = QDBusPendingCallWatcher(bus.asyncCall(message, 5000), self)
        watcher.finished.connect(self.on_reply)

    def on_reply(self, watcher):
        reply = QDBusPendingReply(watcher).reply()
        watcher.deleteLater()
        if reply.type() == QDBusMessage.MessageType.ErrorMessage:
            if reply.errorName() not in SHOTS_PASSING_ERRORS:
                # Plasma before 6.8 only takes screenshots for apps on its own list.
                self.refused = True
                self.queue.clear()
                if not self.warned:
                    self.warned = True
                    print("kdepad: no window thumbnails, the grid shows app icons instead: "
                          f"{reply.errorMessage()}", file=sys.stderr)
            self.finish()
            return
        try:
            info = reply.arguments()[0]
            self.shape = tuple(int(info[key]) for key in ("width", "height", "stride", "format"))
            QImage.Format(self.shape[3])
        except (IndexError, KeyError, TypeError, ValueError):
            self.finish()
            return
        # KWin writes the pixels to the pipe after it has answered.
        os.set_blocking(self.pipe, False)
        self.notifier = QSocketNotifier(self.pipe, QSocketNotifier.Type.Read, self)
        self.notifier.activated.connect(self.on_readable)
        self.timeout.start()

    def on_readable(self):
        width, height, stride, pixel_format = self.shape
        size = stride * height
        try:
            while len(self.data) < size:
                chunk = os.read(self.pipe, 1 << 20)
                if not chunk:
                    break
                self.data += chunk
        except BlockingIOError:
            return  # the rest is still to come
        except OSError:
            pass
        image = None
        if 0 < size <= len(self.data):
            image = QImage(bytes(self.data[:size]), width, height, stride, QImage.Format(pixel_format))
            sharpest = max((screen.devicePixelRatio() for screen in QApplication.screens()), default=1.0)
            limit = thumb_size(THUMB_WIDTHS[2]) * sharpest
            if image.width() > limit.width() or image.height() > limit.height():
                image = image.scaled(limit, Qt.AspectRatioMode.KeepAspectRatio,
                                     Qt.TransformationMode.SmoothTransformation)
            else:
                image = image.copy()  # its own pixels, not the buffer read above
        self.finish(image)

    def finish(self, image=None):
        window_id, self.current = self.current, None
        self.timeout.stop()
        if self.notifier:
            self.notifier.setEnabled(False)
            self.notifier.deleteLater()
            self.notifier = None
        if self.pipe is not None:
            os.close(self.pipe)
            self.pipe = None
        self.data = bytearray()
        stale, self.stale = self.stale, False
        if stale:
            pass
        elif image is not None and not image.isNull():
            self.failed.discard(window_id)
            self.images[window_id] = image
            self.changed.emit(window_id)
        elif not self.refused:
            self.failed.add(window_id)
        self.capture_next()


def thumb_size(width):
    return QSize(width, width * 5 // 8)


def faded(color, alpha):
    color = QColor(color)
    color.setAlpha(alpha)
    return color


class Cards(QStyledItemDelegate):
    """Draws the picker's windows: a card with a thumbnail in the grid, a row in the list."""

    ROW = 48  # the height of a window in the list

    def __init__(self, picker):
        super().__init__(picker)
        self.picker = picker

    def sizeHint(self, option, index):
        return self.picker.cell() if self.picker.view == "grid" else QSize(0, self.ROW)

    def paint(self, painter, option, index):
        window = self.picker.by_id.get(index.data(Qt.ItemDataRole.UserRole))
        if not window:
            return
        grid = self.picker.view == "grid"
        text = option.palette.color(QPalette.ColorRole.WindowText)
        accent = option.palette.color(QPalette.ColorRole.Highlight)
        if grid:  # the card keeps its size where the cell is stretched to fill the row
            card = QRectF(0, 0, self.picker.cell().width() - 8, option.rect.height() - 8)
            card.moveCenter(QRectF(option.rect).center())
        else:
            card = QRectF(option.rect).adjusted(2, 2, -2, -2)
        painter.save()
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        if option.state & QStyle.StateFlag.State_Selected:
            painter.setPen(QPen(accent, 2))
            painter.setBrush(faded(accent, 60))
            painter.drawRoundedRect(card.adjusted(1, 1, -1, -1), 10, 10)
        elif option.state & QStyle.StateFlag.State_MouseOver:
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(faded(text, 22))
            painter.drawRoundedRect(card, 10, 10)
        painter.setPen(text)
        if grid:
            self.paint_card(painter, option, card, window, text)
        else:
            self.paint_row(painter, option, card, window, text)
        painter.restore()

    def paint_card(self, painter, option, card, window, text):
        metrics = option.fontMetrics
        box = QRectF(0, 0, self.picker.thumb_width, thumb_size(self.picker.thumb_width).height())
        box.moveCenter(card.center())
        box.moveTop(card.top() + 10)
        pixmap = self.picker.thumbnail(window, box.size().toSize())
        if pixmap:
            size = pixmap.deviceIndependentSize()
            painter.drawPixmap(QPointF(box.center().x() - size.width() / 2,
                                       box.center().y() - size.height() / 2), pixmap)
        else:  # no picture (yet): the app icon on a quiet backdrop
            painter.save()
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(faded(text, 16))
            painter.drawRoundedRect(box, 8, 8)
            painter.restore()
            side = int(min(96, box.height() * 0.5))
            badge = QRect(0, 0, side, side)
            badge.moveCenter(box.center().toPoint())
            icon_for(window).paint(painter, badge)
        # Under it, the app icon and the title, centred as one.
        lead = 24 if pixmap else 0
        line = QRectF(card.left() + 10, box.bottom() + 8, card.width() - 20, card.bottom() - box.bottom() - 16)
        title = metrics.elidedText(title_of(window), Qt.TextElideMode.ElideRight, int(line.width() - lead))
        left = line.center().x() - (lead + metrics.horizontalAdvance(title)) / 2
        if pixmap:
            icon_for(window).paint(painter, QRect(int(left), int(line.center().y() - 9), 18, 18))
        painter.drawText(QRectF(left + lead, line.top(), line.right() - left - lead, line.height()),
                         Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft, title)

    def paint_row(self, painter, option, card, window, text):
        metrics = option.fontMetrics
        icon_for(window).paint(painter, QRect(int(card.left() + 10), int(card.center().y() - 14), 28, 28))
        line = card.adjusted(50, 0, -12, 0)
        title = title_of(window)
        app = window["app"] or window["cls"]
        if app and app != title:  # which app it is, quietly, at the far end
            app = metrics.elidedText(app, Qt.TextElideMode.ElideRight, int(line.width() * 0.3))
            painter.save()
            painter.setPen(faded(text, 140))
            painter.drawText(line, Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignRight, app)
            painter.restore()
            line.setRight(line.right() - metrics.horizontalAdvance(app) - 16)
        painter.drawText(line, Qt.AlignmentFlag.AlignVCenter | Qt.AlignmentFlag.AlignLeft,
                         metrics.elidedText(title, Qt.TextElideMode.ElideRight, int(line.width())))


class Picker(QWidget):
    """The hidden windows to pick from: a type-to-filter list, or a grid of thumbnails."""

    chosen = pyqtSignal(str)

    def __init__(self, thumbnails):
        super().__init__(None, Qt.WindowType.Window | Qt.WindowType.FramelessWindowHint
                         | Qt.WindowType.WindowStaysOnTopHint)
        self.setWindowTitle("kdepad")
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground)  # for round corners and a shadow
        self.setMouseTracking(True)
        self.setMinimumHeight(300 + 2 * SHADOW)
        self.windows = []
        self.by_id = {}
        self.hint = ""
        self.view = "list"
        self.pixmaps = {}  # window id -> (what it was drawn from, pixmap): thumbnails as the grid shows them
        self.thumbnails = thumbnails
        thumbnails.changed.connect(self.on_thumbnail)

        # What you changed by hand is kept between runs.
        try:
            kept = json.loads(STATE_PATH.read_text())
        except (OSError, ValueError):
            kept = {}
        kept = kept if isinstance(kept, dict) else {}
        sizes = kept.get("sizes") if isinstance(kept.get("sizes"), dict) else {}
        self.sizes = {view: QSize(*size) for view, size in sizes.items()
                      if view in PICKER_VIEWS and isinstance(size, list) and len(size) == 2
                      and all(type(side) is int and 0 < side < 1 << 15 for side in size)}
        self.dragged = False    # you resized the picker since it was last given a size
        self.switching = False  # between hiding one view and being shown again as the other
        self.wheel = 0          # Ctrl+scroll not yet amounting to a step
        width = kept.get("thumbnail")
        self.thumb_width = THUMB_WIDTHS[1]
        if type(width) is int:
            self.thumb_width = max(THUMB_WIDTHS[0], min(THUMB_WIDTHS[2], width))
        self.saved = self.state()

        self.filter = QLineEdit()
        self.filter.setPlaceholderText("Search hidden windows")
        self.filter.setFrame(False)
        self.filter.setClearButtonEnabled(True)
        font = self.filter.font()
        if font.pointSizeF() > 0:
            font.setPointSizeF(font.pointSizeF() * 1.2)
            self.filter.setFont(font)
        for name in ("search", "edit-find", "system-search"):
            if QIcon.hasThemeIcon(name):
                self.filter.addAction(QIcon.fromTheme(name), QLineEdit.ActionPosition.LeadingPosition)
                break
        self.filter.textChanged.connect(self.fill)
        self.filter.installEventFilter(self)

        self.switch = QToolButton()
        self.switch.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        self.switch.clicked.connect(self.switch_view)

        self.rule = QFrame()
        self.rule.setObjectName("rule")
        self.rule.setFixedHeight(1)

        self.list = QListWidget()
        self.list.setFrameShape(QFrame.Shape.NoFrame)
        self.list.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        self.list.setMouseTracking(True)  # for the hover highlight
        self.list.setItemDelegate(Cards(self))
        self.list.setVerticalScrollMode(QListView.ScrollMode.ScrollPerPixel)
        self.list.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self.list.itemClicked.connect(self.choose)
        self.list.installEventFilter(self)
        self.list.viewport().installEventFilter(self)

        self.empty = QLabel()
        self.empty.setObjectName("empty")
        self.empty.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.empty.setWordWrap(True)

        self.hints = QLabel()
        self.hints.setObjectName("hints")
        font = self.hints.font()
        if font.pointSizeF() > 0:
            font.setPointSizeF(font.pointSizeF() * 0.9)
            self.hints.setFont(font)
        self.slider = QSlider(Qt.Orientation.Horizontal)
        self.slider.setRange(THUMB_WIDTHS[0], THUMB_WIDTHS[2])
        self.slider.setSingleStep(THUMB_STEP)
        self.slider.setPageStep(2 * THUMB_STEP)
        self.slider.setValue(self.thumb_width)
        self.slider.setFixedWidth(130)
        self.slider.setFocusPolicy(Qt.FocusPolicy.NoFocus)
        self.slider.setToolTip("Thumbnail size (Ctrl+scroll)")
        self.slider.valueChanged.connect(self.set_thumb_width)

        # A child without a cursor of its own would show the resize arrows of the edge.
        for widget in (self.switch, self.rule, self.list, self.list.viewport(), self.empty, self.hints, self.slider):
            widget.setCursor(Qt.CursorShape.ArrowCursor)

        self.top = QHBoxLayout()
        self.top.setContentsMargins(16, 12, 12, 12)
        self.top.addWidget(self.filter, 1)
        self.top.addWidget(self.switch)
        middle = QVBoxLayout()
        middle.setContentsMargins(8, 8, 8, 0)
        middle.addWidget(self.list, 1)
        middle.addWidget(self.empty, 1)
        self.bottom = QHBoxLayout()
        self.bottom.setContentsMargins(18, 8, 16, 10)
        self.bottom.addWidget(self.hints, 1)
        self.bottom.addWidget(self.slider)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(SHADOW, SHADOW, SHADOW, SHADOW)
        layout.setSpacing(0)
        layout.addLayout(self.top)
        layout.addWidget(self.rule)
        layout.addLayout(middle, 1)
        layout.addLayout(self.bottom)
        self.restyle()
        self.set_view(self.view)

    # --- how it looks ----------------------------------------------------------

    def restyle(self):
        """Colours come from the desktop's own, so the picker is dark where the desktop is."""
        text = self.palette().color(QPalette.ColorRole.WindowText)
        accent = self.palette().color(QPalette.ColorRole.Highlight).name()

        def quiet(alpha):
            return f"rgba({text.red()}, {text.green()}, {text.blue()}, {alpha})"

        self.setStyleSheet(f"""
            QLineEdit {{ background: transparent; border: none; padding: 4px 2px; }}
            QListWidget {{ background: transparent; border: none; outline: none; }}
            QLabel#hints, QLabel#empty {{ color: {quiet(150)}; }}
            QFrame#rule {{ background: {quiet(28)}; border: none; }}
            QToolButton {{ border: none; border-radius: 6px; padding: 6px; }}
            QToolButton:hover {{ background: {quiet(26)}; }}
            QToolButton:pressed {{ background: {quiet(44)}; }}
            QScrollBar:vertical {{ background: transparent; width: 10px; margin: 2px; }}
            QScrollBar::handle:vertical {{ background: {quiet(70)}; border-radius: 3px; min-height: 32px; }}
            QScrollBar::handle:vertical:hover {{ background: {quiet(120)}; }}
            QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{ height: 0; }}
            QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {{ background: transparent; }}
            QSlider::groove:horizontal {{ height: 4px; border-radius: 2px; background: {quiet(50)}; }}
            QSlider::sub-page:horizontal {{ border-radius: 2px; background: {accent}; }}
            QSlider::handle:horizontal {{ width: 14px; height: 14px; margin: -5px 0; border-radius: 7px;
                                          background: {accent}; }}
        """)

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        panel = QRectF(self.rect()).adjusted(SHADOW, SHADOW, -SHADOW, -SHADOW)
        painter.setBrush(Qt.BrushStyle.NoBrush)
        for step in range(SHADOW):  # the shadow: rings that fade with distance, a little lower than the panel
            painter.setPen(QPen(QColor(0, 0, 0, round(34 * (1 - step / SHADOW) ** 2)), 1))
            painter.drawRoundedRect(panel.adjusted(-step, 3 - step, step, 3 + step), 12 + step, 12 + step)
        painter.setPen(QPen(faded(self.palette().color(QPalette.ColorRole.WindowText), 50), 1))
        painter.setBrush(self.palette().color(QPalette.ColorRole.Window))
        painter.drawRoundedRect(panel.adjusted(0.5, 0.5, -0.5, -0.5), 12, 12)

    def cell(self):
        """The least room one window takes in the grid."""
        thumb = thumb_size(self.thumb_width)
        return QSize(thumb.width() + 28, thumb.height() + max(self.fontMetrics().height(), 18) + 36)

    def bar_room(self):
        """The width a grid loses to its scroll bar: QListView leaves that out whether the bar shows or not."""
        style, bar = self.list.style(), self.list.verticalScrollBar()
        if style.pixelMetric(QStyle.PixelMetric.PM_ScrollView_ScrollBarOverlap, None, bar):
            return 0
        return style.pixelMetric(QStyle.PixelMetric.PM_ScrollBarExtent, None, bar)

    def relayout(self):
        """Spread the grid's columns over the width there is."""
        if self.view == "grid":
            # One short of the width, or the last column of an exact fit wraps.
            width = self.list.maximumViewportSize().width() - self.bar_room() - 1
            columns = max(1, width // self.cell().width())
            self.list.setGridSize(QSize(max(self.cell().width(), width // columns), self.cell().height()))
        else:
            self.list.setGridSize(QSize())
        self.setMinimumWidth(max(420, self.one_column()) + 2 * SHADOW)

    def one_column(self):
        """The panel width that fits the grid's widest row of one. Nothing for the list."""
        return self.cell().width() + self.bar_room() + 1 + 16 if self.view == "grid" else 0

    def thumbnail(self, window, box):
        """The window's picture with round corners, to fit the box. None when there is no picture."""
        image = self.thumbnails.images.get(window["id"])
        if image is None:
            return None
        ratio = self.devicePixelRatioF()
        source = (image.cacheKey(), box.width(), box.height(), ratio)
        cached = self.pixmaps.get(window["id"])
        if not cached or cached[0] != source:
            size = image.size() / ratio  # never larger than it is
            if size.width() > box.width() or size.height() > box.height():
                size = size.scaled(box, Qt.AspectRatioMode.KeepAspectRatio)
            pixmap = QPixmap(size * ratio)
            pixmap.fill(Qt.GlobalColor.transparent)
            painter = QPainter(pixmap)
            painter.setRenderHint(QPainter.RenderHint.Antialiasing)
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(Qt.GlobalColor.black)
            painter.drawRoundedRect(QRectF(pixmap.rect()), 8 * ratio, 8 * ratio)
            painter.setCompositionMode(QPainter.CompositionMode.CompositionMode_SourceIn)
            painter.drawImage(0, 0, image.scaled(pixmap.size(), Qt.AspectRatioMode.IgnoreAspectRatio,
                                                 Qt.TransformationMode.SmoothTransformation))
            painter.end()
            pixmap.setDevicePixelRatio(ratio)
            cached = self.pixmaps[window["id"]] = (source, pixmap)
        return cached[1]

    def on_thumbnail(self, window_id):
        if self.view == "grid":
            self.list.viewport().update()

    # --- its size, and the thumbnails' -----------------------------------------

    def state(self):
        return {"sizes": {view: [size.width(), size.height()] for view, size in self.sizes.items()},
                "thumbnail": self.thumb_width}

    def remember(self):
        """Keep the size the picker was dragged to, and the thumbnail size, for next time."""
        if self.dragged:  # not a size the window manager pressed on it
            self.sizes[self.view] = self.size()
            self.dragged = False
        if self.state() != self.saved:
            try:
                STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
                STATE_PATH.write_text(json.dumps(self.state()))
                self.saved = self.state()
            except OSError:
                pass

    def wanted_size(self):
        size = self.sizes.get(self.view)
        if size is None and self.view == "list":
            size = QSize(600 + 2 * SHADOW, 460 + 2 * SHADOW)
        elif size is None:  # three thumbnails across and two down
            around = self.top.sizeHint().height() + self.bottom.sizeHint().height() + 1 + 8 + 2 * SHADOW
            size = QSize(self.one_column() + 2 * self.cell().width() + 2 * SHADOW,
                         2 * self.cell().height() + around)
        screen = self.screen() or QApplication.primaryScreen()
        return size.boundedTo(screen.availableGeometry().size() * 0.95) if screen else size

    def fit(self):
        self.resize(self.wanted_size())
        self.dragged = False

    def set_thumb_width(self, width):
        width = max(THUMB_WIDTHS[0], min(THUMB_WIDTHS[2], width))
        if width != self.thumb_width:
            self.thumb_width = width
            self.slider.setValue(width)
            self.relayout()
            if self.list.currentItem():
                self.list.scrollToItem(self.list.currentItem())

    def edges_at(self, position):
        """The edges a press here would drag: the shadow around the panel is its resize border."""
        x, y, width, height = position.x(), position.y(), self.width(), self.height()
        edges = Qt.Edge(0)
        if SHADOW <= x < width - SHADOW and SHADOW <= y < height - SHADOW:
            return edges
        reach = SHADOW + 12  # near a corner, both edges
        if x < reach:
            edges |= Qt.Edge.LeftEdge
        elif x >= width - reach:
            edges |= Qt.Edge.RightEdge
        if y < reach:
            edges |= Qt.Edge.TopEdge
        elif y >= height - reach:
            edges |= Qt.Edge.BottomEdge
        return edges

    def mouseMoveEvent(self, event):
        if not event.buttons():
            cursor = RESIZE_CURSORS.get(self.edges_at(event.position().toPoint()))
            if cursor is None:
                self.unsetCursor()
            else:
                self.setCursor(cursor)
        super().mouseMoveEvent(event)

    def mousePressEvent(self, event):
        edges = self.edges_at(event.position().toPoint())
        if event.button() == Qt.MouseButton.LeftButton and edges and self.windowHandle():
            # The window manager takes the drag from here.
            self.dragged = self.windowHandle().startSystemResize(edges) or self.dragged
        super().mousePressEvent(event)

    def hideEvent(self, event):
        self.remember()
        super().hideEvent(event)

    # --- what it shows ---------------------------------------------------------

    def open(self, windows, hint):
        self.hint = hint
        self.filter.clear()
        self.restyle()
        self.set_windows(windows)
        self.fit()
        self.show()
        self.raise_()
        self.activateWindow()
        self.filter.setFocus()
        self.take_pictures()

    def set_windows(self, windows):
        self.windows = windows
        self.by_id = {window["id"]: window for window in windows}
        self.pixmaps = {key: pixmap for key, pixmap in self.pixmaps.items() if key in self.by_id}
        self.fill()

    def set_view(self, view):
        if self.isVisible():
            self.remember()
        self.view = view
        grid = view == "grid"
        other = "list" if grid else "grid"
        icon = QIcon.fromTheme("view-list-details" if grid else "view-grid",
                               QIcon.fromTheme("view-list-symbolic" if grid else "view-grid-symbolic"))
        self.switch.setIcon(icon)
        self.switch.setText(other.capitalize())
        self.switch.setToolButtonStyle(Qt.ToolButtonStyle.ToolButtonTextOnly if icon.isNull()
                                       else Qt.ToolButtonStyle.ToolButtonIconOnly)
        self.switch.setToolTip(f"Show a {other} (Ctrl+G)")
        keys = ["Enter  show", f"Ctrl+G  {other}"] + (["Ctrl+scroll  thumbnail size"] if grid else [])
        self.hints.setText("     ".join(keys))
        self.slider.setVisible(grid)
        self.list.setViewMode(QListView.ViewMode.IconMode if grid else QListView.ViewMode.ListMode)
        self.list.setMovement(QListView.Movement.Static)  # changing the view mode makes items draggable
        self.list.setResizeMode(QListView.ResizeMode.Adjust)
        self.fit()
        self.relayout()
        self.fill()

    def switch_view(self):
        self.set_view("list" if self.view == "grid" else "grid")
        if self.isVisible():
            # A window cannot move itself on Wayland; shown again at its new
            # size, KWin places it afresh. Word that the old one lost the focus
            # can come after that, and must not close the new one.
            self.switching = True
            QTimer.singleShot(1000, lambda: setattr(self, "switching", False))
            self.hide()
            self.show()
            self.raise_()
            self.activateWindow()
            self.filter.setFocus()
            self.take_pictures()

    def take_pictures(self):
        if self.view == "grid":
            self.thumbnails.request(window["id"] for window in self.windows)

    def fill(self):
        words = self.filter.text().lower().split()
        current = self.list.currentItem()
        keep = current.data(Qt.ItemDataRole.UserRole) if current else None
        self.list.clear()
        for window in self.windows:
            haystack = " ".join((window["caption"], window["cls"], window["app"])).lower()
            if all(word in haystack for word in words):
                item = QListWidgetItem(title_of(window))  # drawn by Cards
                item.setData(Qt.ItemDataRole.UserRole, window["id"])
                item.setToolTip(title_of(window))
                self.list.addItem(item)
                if window["id"] == keep:
                    self.list.setCurrentItem(item)
        if self.list.count() and not self.list.currentItem():
            self.list.setCurrentRow(0)
        self.empty.setText("No hidden window matches." if self.windows else self.hint)
        self.list.setVisible(self.list.count() > 0)
        self.empty.setVisible(self.list.count() == 0)

    def choose(self, item=None):
        item = item or self.list.currentItem()
        if item:
            self.hide()
            self.chosen.emit(item.data(Qt.ItemDataRole.UserRole))

    def eventFilter(self, watched, event):
        control = Qt.KeyboardModifier.ControlModifier
        if watched is self.list:
            if event.type() == QEvent.Type.Resize:
                self.relayout()
        elif watched is self.list.viewport():
            if event.type() == QEvent.Type.Wheel and event.modifiers() & control and self.view == "grid":
                # A step per notch: touchpads and smooth wheels send a notch in many small parts.
                self.wheel += event.angleDelta().y()
                steps = int(self.wheel / 120)
                if steps:
                    self.wheel -= steps * 120
                    self.set_thumb_width(self.thumb_width + steps * THUMB_STEP)
                return True
        elif watched is self.filter and event.type() == QEvent.Type.KeyPress:
            key = event.key()
            moves = [Qt.Key.Key_Up, Qt.Key.Key_Down, Qt.Key.Key_PageUp, Qt.Key.Key_PageDown]
            if self.view == "grid":
                moves += [Qt.Key.Key_Left, Qt.Key.Key_Right]
            if key in moves:
                QApplication.sendEvent(self.list, event)
                return True
            if key in (Qt.Key.Key_Return, Qt.Key.Key_Enter):
                self.choose()
                return True
            if key == Qt.Key.Key_Escape:
                self.hide()
                return True
            if event.modifiers() & control:
                if key == Qt.Key.Key_G:
                    self.switch_view()
                    return True
                larger, smaller = self.thumb_width + THUMB_STEP, self.thumb_width - THUMB_STEP
                sizes = {Qt.Key.Key_Plus: larger, Qt.Key.Key_Equal: larger, Qt.Key.Key_Minus: smaller,
                         Qt.Key.Key_0: THUMB_WIDTHS[1]}
                if key in sizes and self.view == "grid":
                    self.set_thumb_width(sizes[key])
                    return True
        return super().eventFilter(watched, event)

    def changeEvent(self, event):
        if event.type() == QEvent.Type.ActivationChange and self.isVisible():
            if self.isActiveWindow():
                self.switching = False
            elif not self.switching:
                QTimer.singleShot(0, self.hide)
        super().changeEvent(event)


@pyqtClassInfo("D-Bus Interface", SERVICE)
class Bridge(QObject):
    """The D-Bus face of the daemon: called by the KWin script and by the CLI."""

    def __init__(self, daemon):
        super().__init__(daemon)
        self.daemon = daemon

    @pyqtSlot(str)
    def State(self, payload):
        self.daemon.on_state(payload)

    @pyqtSlot(result=str)
    def TakeCommands(self):
        return self.daemon.take_commands()

    @pyqtSlot()
    def ShowPicker(self):
        self.daemon.toggle_picker()

    @pyqtSlot(str)
    def Launch(self, name):
        self.daemon.launch(name)

    @pyqtSlot(result=str)
    def Windows(self):
        return json.dumps(self.daemon.windows)

    @pyqtSlot(result=str)
    def Reload(self):
        return self.daemon.reload()

    @pyqtSlot()
    def RestoreAll(self):
        self.daemon.send(op="restore_all")

    @pyqtSlot()
    def Quit(self):
        QTimer.singleShot(0, self.daemon.quit)


class Daemon(QObject):
    def __init__(self, app):
        super().__init__()
        self.app = app
        self.config = {"shortcuts": dict(DEFAULT_SHORTCUTS), "picker": {"view": "list"}, "apps": []}
        self.windows = []
        self.commands = deque()
        self.script_file = None
        self.script_seen = False
        self.loads = 0
        self.recovered = False
        self.quitting = False

        self.thumbnails = Thumbnails(self)
        self.picker = Picker(self.thumbnails)
        self.picker.chosen.connect(self.show_window)

        self.menu = QMenu()
        self.tray = QSystemTrayIcon(QIcon.fromTheme("view-hidden"), self)
        self.tray.setContextMenu(self.menu)
        self.tray.activated.connect(self.on_tray_activated)

        self.unanswered = QTimer(self, singleShot=True, interval=1500)
        self.unanswered.timeout.connect(self.on_unanswered)

        self.kwin_watcher = QDBusServiceWatcher(
            "org.kde.KWin", QDBusConnection.sessionBus(),
            QDBusServiceWatcher.WatchModeFlag.WatchForRegistration, self)
        self.kwin_watcher.serviceRegistered.connect(lambda _: QTimer.singleShot(1000, self.load_script))

    def start(self):
        bus = QDBusConnection.sessionBus()
        self.bridge = Bridge(self)
        if not bus.registerService(SERVICE):
            sys.exit("kdepad is already running")
        bus.registerObject(OBJECT, self.bridge, QDBusConnection.RegisterOption.ExportAllSlots)

        try:
            self.config = load_config(CONFIG_PATH)
        except ConfigError as error:
            self.warn(f"Config ignored: {error}")
        self.picker.set_view(self.config["picker"]["view"])
        self.refresh()
        self.show_tray()
        if bus.interface().isServiceRegistered("org.kde.KWin").value():
            self.load_script(initial=True)
        else:
            print("kdepad: waiting for KWin", file=sys.stderr)

    # --- talking to the user -------------------------------------------------

    def warn(self, text):
        print(f"kdepad: {text}", file=sys.stderr)
        if self.tray.isVisible():
            self.tray.showMessage("kdepad", text, QSystemTrayIcon.MessageIcon.Warning)

    def announce(self, text, tries=0):
        """Say something once the tray icon is there to say it from."""
        if self.tray.isVisible():
            self.tray.showMessage("kdepad", text, QSystemTrayIcon.MessageIcon.Information)
        elif tries < 10:
            QTimer.singleShot(1000, lambda: self.announce(text, tries + 1))
        if not tries:
            print(f"kdepad: {text}", file=sys.stderr)

    def show_tray(self, tries=0):
        if QSystemTrayIcon.isSystemTrayAvailable():
            self.tray.show()
        elif tries < 60:
            QTimer.singleShot(1000, lambda: self.show_tray(tries + 1))

    def hidden(self):
        return sorted((w for w in self.windows if w["hidden"]), key=lambda w: -w["seq"])

    def stash_hint(self):
        key = self.config["shortcuts"]["stash"]
        return f"Nothing is hidden. {key} hides the focused window." if key else "Nothing is hidden."

    def refresh(self):
        hidden = self.hidden()
        self.menu.clear()
        for window in hidden:
            title = title_of(window)
            title = title if len(title) <= 60 else title[:59] + "…"
            action = self.menu.addAction(icon_for(window), title.replace("&", "&&"))
            action.triggered.connect(lambda _=False, window_id=window["id"]: self.show_window(window_id))
        if not hidden:
            self.menu.addAction("Nothing hidden").setEnabled(False)
        self.menu.addSeparator()
        self.menu.addAction("Bring everything back", lambda: self.send(op="restore_all")).setEnabled(bool(hidden))
        self.menu.addAction("Reload config", self.reload)
        self.menu.addAction("Edit config", self.edit_config)
        self.menu.addAction("Quit kdepad", self.quit)
        count = len(hidden)
        self.tray.setToolTip(f"kdepad: {count} hidden window{'' if count == 1 else 's'}")
        self.thumbnails.keep(window["id"] for window in hidden)
        if self.picker.view == "grid":
            # Taken as soon as a window is hidden, so the grid has it when it opens.
            self.thumbnails.request((window["id"] for window in hidden), again=False)
        if self.picker.isVisible():
            self.picker.set_windows(hidden)

    def on_tray_activated(self, reason):
        if reason == QSystemTrayIcon.ActivationReason.Trigger:
            self.toggle_picker()

    def toggle_picker(self):
        if self.picker.isVisible():
            self.picker.hide()
        else:
            self.picker.open(self.hidden(), self.stash_hint())

    def edit_config(self):
        if not CONFIG_PATH.exists():
            CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
            CONFIG_PATH.write_text(DEFAULT_CONFIG)
        QDesktopServices.openUrl(QUrl.fromLocalFile(str(CONFIG_PATH)))

    def launch(self, name):
        command = next((app["command"] for app in self.config["apps"] if app["name"] == name), "")
        try:
            parts = shlex.split(command)
        except ValueError as error:
            parts = []
            self.warn(f"Bad command for {name}: {error}")
        if parts and not QProcess.startDetached(parts[0], parts[1:])[0]:
            self.warn(f"Could not start {name}: {command}")

    # --- talking to KWin -----------------------------------------------------

    def load_script(self, initial=False):
        """(Re)load the KWin script with the current config baked in."""
        apps = [{**app, "canLaunch": bool(app["command"])} for app in self.config["apps"]]
        payload = {"initial": initial, "shortcuts": self.config["shortcuts"], "apps": apps}
        try:
            source = KWIN_SCRIPT.replace("__KDEPAD_CONFIG__", json.dumps(payload))
            RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
            self.loads += 1
            previous, self.script_file = self.script_file, RUNTIME_DIR / f"kdepad-{os.getpid()}-{self.loads}.js"
            self.script_file.write_text(source)
            if previous:
                previous.unlink(missing_ok=True)
        except OSError as error:
            self.warn(f"Could not prepare the KWin script: {error}")
            return
        self.script_seen = False
        self.thumbnails.refused = False  # a restarted KWin may answer differently
        try:
            kwin_scripting("unloadScript", PLUGIN)
        except BusError as error:
            self.warn(f"KWin is not answering: {error}")
            return
        # KWin keeps whatever key an action had before. Forget the keys the
        # config sets so the config file is what decides them.
        keyed = [SHORTCUT_ACTIONS[k] for k, v in self.config["shortcuts"].items() if v]
        keyed += [app["action"] for app in apps if app["shortcut"]]
        for action in keyed:
            try:
                call("org.kde.kglobalaccel", "/kglobalaccel", "org.kde.KGlobalAccel", "unregister", "kwin", action)
            except BusError:
                pass
        self.try_load(self.script_file)

    def try_load(self, path, attempt=0):
        if path != self.script_file:
            return
        try:
            script_id = kwin_scripting("loadScript", str(path), PLUGIN)
            if script_id is not None and script_id < 0:
                # The previous copy has not finished unloading yet.
                if attempt < 20:
                    QTimer.singleShot(100, lambda: self.try_load(path, attempt + 1))
                else:
                    self.warn("KWin would not replace the old kdepad script")
                return
            kwin_scripting("start")
        except BusError as error:
            self.warn(f"KWin did not load the script: {error}")
            return
        QTimer.singleShot(4000, lambda: self.check_script(path))

    def check_script(self, path):
        if path == self.script_file and not self.script_seen:
            self.warn("The KWin script did not start. Look for errors with: "
                      "journalctl --user -b | grep -i -e kdepad -e kwin_scripting")

    def send(self, **command):
        self.commands.append(command)
        call("org.kde.kglobalaccel", "/component/kwin", "org.kde.kglobalaccel.Component",
             "invokeShortcut", "kdepad_command", block=False)
        self.unanswered.start()

    def take_commands(self):
        self.script_seen = True
        commands = list(self.commands)
        self.commands.clear()
        self.unanswered.stop()
        return json.dumps(commands)

    def on_unanswered(self):
        if not self.commands or self.quitting:
            return
        if self.recovered:
            self.commands.clear()
            self.warn("KWin is not reacting to kdepad. Try \"Reload config\" from this menu.")
        else:
            # A freshly loaded script collects pending commands when it starts.
            self.recovered = True
            self.load_script()

    def on_state(self, payload):
        self.script_seen = True
        try:
            self.windows = json.loads(payload)["windows"]
        except (ValueError, KeyError, TypeError):
            return
        self.refresh()
        if self.quitting and not self.hidden():
            self.finish_quit()

    def show_window(self, window_id):
        self.send(op="show", id=window_id)

    def reload(self):
        before = self.config["picker"]["view"]
        try:
            self.config = load_config(CONFIG_PATH)
        except ConfigError as error:
            self.warn(f"Config not reloaded: {error}")
            return str(error)
        self.recovered = False
        if self.config["picker"]["view"] != before:  # otherwise the view stays as Ctrl+G left it
            self.picker.set_view(self.config["picker"]["view"])
        self.load_script()
        self.refresh()
        return ""

    def quit(self):
        """Bring every hidden window back, then leave."""
        if self.quitting:
            return
        self.quitting = True
        self.picker.hide()
        if self.hidden():
            self.send(op="restore_all")
            QTimer.singleShot(1500, self.finish_quit)
        else:
            self.finish_quit()

    def finish_quit(self):
        if self.script_file:
            try:
                kwin_scripting("unloadScript", PLUGIN)
            except BusError:
                pass
            self.script_file.unlink(missing_ok=True)
            self.script_file = None
        self.app.quit()


def run_daemon():
    try:
        first_run = register()
    except OSError as error:
        first_run = False
        print(f"kdepad: could not set up autostart: {error}", file=sys.stderr)
    app = QApplication(sys.argv[:1])
    app.setApplicationName("kdepad")
    app.setDesktopFileName("kdepad")
    app.setQuitOnLastWindowClosed(False)
    if not QDBusConnection.sessionBus().isConnected():
        sys.exit("kdepad: no D-Bus session bus")
    daemon = Daemon(app)

    # Qt's event loop does not run Python signal handlers on its own; a byte on
    # this socket wakes it up when a signal arrives.
    reader, writer = socket.socketpair()
    writer.setblocking(False)
    signal.set_wakeup_fd(writer.fileno())
    notifier = QSocketNotifier(reader.fileno(), QSocketNotifier.Type.Read)
    notifier.activated.connect(lambda: reader.recv(64))
    for number in (signal.SIGINT, signal.SIGTERM):
        signal.signal(number, lambda *_: QTimer.singleShot(0, daemon.quit))

    daemon.start()
    if first_run:
        daemon.announce("Set up to start at login from now on. `kdepad uninstall` undoes that.")
    return app.exec()


def daemon_running():
    return QDBusConnection.sessionBus().interface().isServiceRegistered(SERVICE).value()


def run_client(command):
    if not daemon_running():
        sys.exit("kdepad is not running. Start it with: kdepad")
    method = {"windows": "Windows", "pick": "ShowPicker", "reload": "Reload",
              "restore": "RestoreAll", "quit": "Quit"}[command]
    try:
        result = call(SERVICE, OBJECT, SERVICE, method)
    except BusError as error:
        sys.exit(f"kdepad: {error}")
    if command == "reload" and result:
        sys.exit(f"kdepad: {result}")
    if command == "windows":
        windows = sorted(json.loads(result), key=lambda w: (not w["hidden"], w["cls"].lower()))
        if not windows:
            print("No windows reported yet.")
            return 0
        width = max(len(w["cls"]) for w in windows)
        print(f"{'':6}  {'CLASS':{width}}  TITLE")
        for w in windows:
            print(f"{'hidden' if w['hidden'] else '':6}  {w['cls']:{width}}  {w['caption']}")
        print("\nUse a CLASS value as `match` in", CONFIG_PATH)
    return 0


def register():
    """Add this file to the app launcher, login autostart and PATH, where it is.

    Nothing is copied. Does nothing and returns False when the launcher entry
    already points here, so removing only the autostart entry sticks.
    """
    quoted = str(ME)
    for char in '\\"$`':
        quoted = quoted.replace(char, "\\" + char)
    entry = ("[Desktop Entry]\nType=Application\nName=kdepad\n"
             "Comment=Hide windows off every desktop and call them back\n"
             f'Exec="{quoted}"\nIcon=view-hidden\nCategories=Utility;\nStartupNotify=false\n')
    try:
        if LAUNCHER.read_text() == entry:
            return False
    except OSError:
        pass
    for path in (LAUNCHER, AUTOSTART):
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(entry)
    BIN_LINK.parent.mkdir(parents=True, exist_ok=True)
    if BIN_LINK.is_symlink() or not BIN_LINK.exists():
        BIN_LINK.unlink(missing_ok=True)
        BIN_LINK.symlink_to(ME)
    if not CONFIG_PATH.exists():
        CONFIG_PATH.parent.mkdir(parents=True, exist_ok=True)
        CONFIG_PATH.write_text(DEFAULT_CONFIG)
    return True


def uninstall():
    if daemon_running():
        call(SERVICE, OBJECT, SERVICE, "Quit")
    for path in (LAUNCHER, AUTOSTART, STATE_PATH):
        path.unlink(missing_ok=True)
    try:
        STATE_PATH.parent.rmdir()
    except OSError:
        pass
    if BIN_LINK.is_symlink():
        BIN_LINK.unlink()
    print(f"kdepad no longer starts at login. Left in place: {ME} and {CONFIG_PATH}\n"
          "Running it again sets it up again.")
    return 0


USAGE = """\
commands:
  (none)      run the tray daemon; the first run also sets it up to start at
              login, adds it to the app launcher and puts `kdepad` on PATH
  uninstall   undo that setup (hidden windows come back first)
  windows     list open windows with their class and whether they are hidden
  pick        open the list of hidden windows
  reload      re-read the config
  restore     bring every hidden window back
  quit        restore, then stop the daemon

default keys (change them in the config):
  Meta+H          hide the focused window
  Meta+Shift+H    list the hidden windows; type to filter, Enter to pick
  Meta+Ctrl+H     bring back the most recently hidden window

The tray icon does the same with the mouse. A window you bring back lands on
the desktop you are on. Quitting kdepad brings every hidden window back.

The list of hidden windows can also be a larger grid of window thumbnails;
Ctrl+G switches between the two. In the grid, Ctrl+scroll, Ctrl+plus and
Ctrl+minus change the thumbnail size (Ctrl+0 puts it back). Dragging the
picker's edge resizes it. Both sizes are remembered.

Config: ~/.config/kdepad/config.toml (tray menu > Edit config). It also sets
whether kdepad starts with the list or the grid, per-app show/hide keys and
apps that hide as soon as they open. A key that another shortcut already owns
is silently not assigned; pick another one.
Script errors: journalctl --user -b | grep -i -e kdepad -e kwin_scripting
"""

DEFAULT_CONFIG = """\
# kdepad config. After editing: `kdepad reload`, or "Reload config" in the tray menu.
#
# Keys are written the way System Settings shows them: "Meta+H", "Ctrl+Alt+M".
# Use "" for no key. A key that another shortcut already owns is silently not
# assigned, so if a key does nothing, pick another one.

[shortcuts]
stash  = "Meta+H"        # hide the focused window
picker = "Meta+Shift+H"  # list the hidden windows and pick one
last   = "Meta+Ctrl+H"   # bring back the most recently hidden window

[picker]
view = "list"            # "grid" starts with a larger window of thumbnails; Ctrl+G switches

# One [[app]] block per app that gets its own show/hide key.
# Find `match` with `kdepad windows` while the app is open (the CLASS column).
#
# [[app]]
# name      = "Music"       # shown in System Settings and messages
# match     = "spotify"     # window class; a list works too: ["a", "b"]
# shortcut  = "Meta+S"      # hides the app when focused, otherwise brings it to you
# autostash = true          # hide its window as soon as it opens
# command   = "spotify"     # started by the shortcut when the app is not running
"""

# The half of kdepad that runs inside KWin. The daemon loads it over D-Bus with
# __KDEPAD_CONFIG__ replaced by the config. It owns the shortcuts and does the
# hiding: a hidden window is minimized and flagged to skip the taskbar, the
# pager and the window switcher. Those window properties are the only record of
# "hidden", so a freshly loaded copy picks up windows hidden by an earlier one.
KWIN_SCRIPT = r'''
var CONFIG = __KDEPAD_CONFIG__;

var SERVICE = "org.kdepad.Daemon";
var OBJECT = "/Daemon";
var OWN_CLASS = "kdepad";
var NEW_WINDOW_MS = 5000;
var LAUNCH_MS = 60000;

var hidden = {};     // window id -> {window, saved flags, seq}
var hideSeq = 0;
var fresh = {};      // window id -> time it appeared, until its app is known
var launching = {};  // app index -> time we asked the daemon to start it
var published = {};  // window ids in the last state sent to the daemon

function wid(w) { return String(w.internalId); }
function lower(s) { return String(s || "").toLowerCase(); }

function allWindows() {
    var list = workspace.windowList(), out = [];
    for (var i = 0; i < list.length; i++) {
        out.push(list[i]);
    }
    return out;
}

function isOwn(w) {
    return lower(w.resourceClass) === OWN_CLASS || lower(w.desktopFileName) === OWN_CLASS;
}

// Application windows, as opposed to panels, menus, tooltips and the like.
function ordinary(w) {
    return !!w && w.managed && !w.deleted && !w.specialWindow
        && (w.normalWindow || w.dialog || w.utility);
}

function eligible(w) {
    return ordinary(w) && !isOwn(w);
}

// A dialog is hidden together with the window it belongs to.
function root(w) {
    var hops = 0;
    while (w && w.transient && w.transientFor && hops++ < 16) {
        w = w.transientFor;
    }
    return w;
}

function appOf(w) {
    var keys = [lower(w.resourceClass), lower(w.resourceName), lower(w.desktopFileName)];
    for (var a = 0; a < CONFIG.apps.length; a++) {
        var match = CONFIG.apps[a].match;
        for (var m = 0; m < match.length; m++) {
            if (keys.indexOf(match[m]) >= 0) {
                return a;
            }
        }
    }
    return -1;
}

function appWindows(a) {
    return allWindows().filter(function (w) {
        return eligible(w) && !w.transient && appOf(w) === a;
    });
}

function restoreFlags(w, saved) {
    w.skipTaskbar = saved.skipTaskbar;
    w.skipPager = saved.skipPager;
    w.skipSwitcher = saved.skipSwitcher;
}

// Hidden windows get their flags set again whenever they change. KWin itself
// puts an XWayland window back in the taskbar each time it re-evaluates the
// window's visibility (when it is minimized, on a desktop switch), and an app
// can change the flags too.
function enforce(w) {
    if (!w.skipTaskbar) {
        w.skipTaskbar = true;
    }
    if (!w.skipPager) {
        w.skipPager = true;
    }
    if (!w.skipSwitcher) {
        w.skipSwitcher = true;
    }
}

function hide(w) {
    w = root(w);
    if (!eligible(w) || hidden[wid(w)]) {
        return false;
    }
    // Recorded before minimizing, so that enforce() already applies while KWin
    // minimizes the window.
    hidden[wid(w)] = {
        window: w,
        saved: {skipTaskbar: w.skipTaskbar, skipPager: w.skipPager, skipSwitcher: w.skipSwitcher},
        seq: ++hideSeq
    };
    enforce(w);
    w.minimized = true;
    if (!w.minimized) {  // KWin refused, e.g. a window rule forbids minimizing
        forget(w);
        return false;
    }
    return true;
}

function forget(w) {
    var entry = hidden[wid(w)];
    if (entry) {
        delete hidden[wid(w)];
        restoreFlags(w, entry.saved);
    }
    return !!entry;
}

function bringHere(w) {
    var activity = workspace.currentActivity;
    if (activity && w.activities.length > 0 && w.activities.indexOf(activity) < 0) {
        w.activities = [activity];
    }
    if (!w.onAllDesktops) {
        w.desktops = [workspace.currentDesktop];
    }
}

function show(w) {
    forget(w);
    bringHere(w);
    if (w.minimized) {
        w.minimized = false;
    }
    workspace.activeWindow = w;
}

function hiddenByAge() {
    var entries = [];
    for (var id in hidden) {
        entries.push(hidden[id]);
    }
    entries.sort(function (x, y) { return y.seq - x.seq; });
    return entries;
}

function showLast() {
    var entries = hiddenByAge();
    if (entries.length) {
        show(entries[0].window);
    }
}

function restoreAll() {
    hiddenByAge().forEach(function (entry) {
        forget(entry.window);
        entry.window.minimized = false;
    });
}

function toggleApp(a) {
    var windows = appWindows(a);
    if (!windows.length) {
        if (CONFIG.apps[a].canLaunch) {
            launching[a] = Date.now();
            callDBus(SERVICE, OBJECT, SERVICE, "Launch", CONFIG.apps[a].name);
        }
        return;
    }
    var away = windows.filter(function (w) { return !!hidden[wid(w)]; });
    if (away.length) {
        away.forEach(show);
        return;
    }
    var active = workspace.activeWindow ? root(workspace.activeWindow) : null;
    if (active && eligible(active) && appOf(active) === a) {
        windows.forEach(hide);
        return;
    }
    // Open but not in front of you (other desktop, buried, minimized): fetch
    // the topmost one instead of hiding something you may not be looking at.
    var order = workspace.stackingOrder, top = windows[0];
    for (var i = 0; i < order.length; i++) {
        if (eligible(order[i]) && !order[i].transient && appOf(order[i]) === a) {
            top = order[i];
        }
    }
    show(top);
}

function publish(skipId) {
    var windows = [];
    published = {};
    allWindows().forEach(function (w) {
        var id = wid(w);
        if (id === skipId || !eligible(w) || (w.transient && !hidden[id])) {
            return;
        }
        published[id] = true;
        var a = appOf(w);
        windows.push({
            id: id,
            cls: String(w.resourceClass),
            name: String(w.resourceName),
            desktopFile: String(w.desktopFileName),
            caption: String(w.caption),
            app: a >= 0 ? CONFIG.apps[a].name : "",
            hidden: !!hidden[id],
            seq: hidden[id] ? hidden[id].seq : 0
        });
    });
    callDBus(SERVICE, OBJECT, SERVICE, "State", JSON.stringify({windows: windows}));
}

// The picker is an ordinary window with no say over its own focus on Wayland,
// so it is put in front from here.
function adoptPicker(w) {
    w.skipTaskbar = true;
    w.skipPager = true;
    w.skipSwitcher = true;
    w.keepAbove = true;
    workspace.activeWindow = w;
}

// Runs when a window appears and again if its class arrives late.
function classify(w) {
    var id = wid(w);
    if (!fresh[id]) {
        return;
    }
    if (Date.now() - fresh[id] > NEW_WINDOW_MS) {
        delete fresh[id];
        return;
    }
    if (isOwn(w)) {
        delete fresh[id];
        adoptPicker(w);
        return;
    }
    var a = appOf(w);
    if (a < 0) {
        return;
    }
    delete fresh[id];
    if (!CONFIG.apps[a].autostash || !w.normalWindow || w.transient) {
        return;
    }
    if (launching[a] && Date.now() - launching[a] < LAUNCH_MS) {
        delete launching[a];  // you just asked for this app, so let it show
        return;
    }
    var onShow = appWindows(a).filter(function (other) {
        return wid(other) !== id && !hidden[wid(other)];
    });
    if (!onShow.length && hide(w)) {
        publish();
    }
}

function track(w) {
    w.minimizedChanged.connect(function () {
        // Something else brought it back (its tray icon, a notification).
        if (!w.minimized && forget(w)) {
            publish();
        }
    });
    w.captionChanged.connect(function () {
        if (hidden[wid(w)]) {
            publish();
        }
    });
    w.windowClassChanged.connect(function () {
        classify(w);
    });
    var keepHidden = function () {
        if (hidden[wid(w)]) {
            enforce(w);
        }
    };
    w.skipTaskbarChanged.connect(keepHidden);
    w.skipPagerChanged.connect(keepHidden);
    w.skipSwitcherChanged.connect(keepHidden);
}

function runCommands(json) {
    var commands = [];
    try {
        commands = JSON.parse(json);
    } catch (e) {
        print("kdepad: bad command list: " + json);
    }
    commands.forEach(function (command) {
        if (command.op === "show") {
            var entry = hidden[command.id];
            if (entry) {
                show(entry.window);
            }
        } else if (command.op === "restore_all") {
            restoreAll();
        }
    });
    publish();
}

function fetchCommands() {
    callDBus(SERVICE, OBJECT, SERVICE, "TakeCommands", runCommands);
}

workspace.windowAdded.connect(function (w) {
    if (!ordinary(w)) {
        return;
    }
    track(w);
    fresh[wid(w)] = Date.now();
    classify(w);
    publish();
});

workspace.windowRemoved.connect(function (w) {
    var id = wid(w);
    delete hidden[id];
    delete fresh[id];
    if (published[id]) {
        publish(id);
    }
});

registerShortcut("kdepad_stash", "kdepad: Hide the active window", CONFIG.shortcuts.stash, function () {
    if (workspace.activeWindow && hide(workspace.activeWindow)) {
        publish();
    }
});
registerShortcut("kdepad_last", "kdepad: Bring back the last hidden window", CONFIG.shortcuts.last, function () {
    showLast();
    publish();
});
registerShortcut("kdepad_picker", "kdepad: List hidden windows", CONFIG.shortcuts.picker, function () {
    callDBus(SERVICE, OBJECT, SERVICE, "ShowPicker");
});
CONFIG.apps.forEach(function (app, a) {
    registerShortcut(app.action, "kdepad: Show/hide " + app.name, app.shortcut, function () {
        toggleApp(a);
        publish();
    });
});
// The daemon triggers this by name to make the script collect its commands.
registerShortcut("kdepad_command", "kdepad: internal, leave unassigned", "", fetchCommands);

allWindows().forEach(function (w) {
    if (!ordinary(w)) {
        return;
    }
    track(w);
    // Not the taskbar flag: KWin may have reset it while no script was loaded.
    if (eligible(w) && w.minimized && w.skipPager && w.skipSwitcher) {
        hidden[wid(w)] = {
            window: w,
            saved: {skipTaskbar: false, skipPager: false, skipSwitcher: false},
            seq: ++hideSeq
        };
        enforce(w);
    } else if (CONFIG.initial && eligible(w) && w.normalWindow && !w.transient) {
        var a = appOf(w);
        if (a >= 0 && CONFIG.apps[a].autostash) {
            hide(w);
        }
    }
});
fetchCommands();
'''


def main():
    parser = argparse.ArgumentParser(prog="kdepad", description=__doc__.split("\n\n")[0], epilog=USAGE,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", action="version", version=f"kdepad {VERSION}")
    parser.add_argument("command", nargs="?", default="daemon", metavar="command",
                        choices=["daemon", "uninstall", "windows", "pick", "reload", "restore", "quit"])
    command = parser.parse_args().command
    if command == "daemon":
        return run_daemon()
    app = QCoreApplication(sys.argv[:1])  # noqa: F841 (QtDBus wants an application object)
    if command == "uninstall":
        return uninstall()
    return run_client(command)


if __name__ == "__main__":
    sys.exit(main())
